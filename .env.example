COOLIFY_INSTANCE_URL=https://your-coolify-instance.com
COOLIFY_API_TOKEN=your_api_token_here

# Required for the browser-based admin editor. Use a long random value,
# for example: openssl rand -hex 32
# ADMIN_TOKEN=replace_with_a_long_random_token

# Optional: directory containing custom_links.json.
# Defaults to /app/data in production, otherwise the project directory.
# DATA_DIR=/app/data